# ============================================================
# Product Request Tracker — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ─── FRESHSERVICE ───────────────────────────────────────────
# Your Freshservice domain (without https://)
FRESHSERVICE_DOMAIN=yourcompany.freshservice.com

# API key: Admin → Profile → API Key
FRESHSERVICE_API_KEY=your_freshservice_api_key_here

# The API name of the custom text field on Freshservice tickets
# that stores the linked Jira ticket key (e.g., "DPS-100999").
# Find it in Admin → Form Fields → Ticket Fields → your custom field.
# The API name looks like: cf_jira_ticket
FRESHSERVICE_JIRA_FIELD=cf_jira_ticket

# ─── JIRA (Atlassian Cloud) ────────────────────────────────
# Your Atlassian Cloud domain (without https://)
JIRA_DOMAIN=yourcompany.atlassian.net

# Service account email used for API authentication.
# Create a dedicated service account — don't use personal credentials.
JIRA_EMAIL=service-account@yourcompany.com

# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# The custom field ID in Jira that stores the Freshservice ticket number.
# Find it in Jira Settings → Issues → Custom Fields → select field → note the ID.
# Format: customfield_XXXXX
JIRA_FRESHSERVICE_FIELD=customfield_10050

# ─── EMAIL (SMTP via M365 / Outlook) ───────────────────────
# Option A: Microsoft 365 SMTP (recommended)
#   - Host: smtp.office365.com
#   - Port: 587
#   - Use a shared mailbox or no-reply address
#   - Requires App Password or OAuth2 token
#
# Option B: Gmail SMTP (quick testing)
#   - Host: smtp.gmail.com
#   - Port: 587
#   - Requires App Password (not your regular password)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply-product@yourcompany.com
SMTP_PASS=your_app_password_here

# Display name shown in the "From" field of emails
SMTP_FROM_NAME=Product Request Updates

# ─── INTERNAL ROUTING ──────────────────────────────────────
# Email address for the product team — receives "ask product to review" requests
PRODUCT_TEAM_EMAIL=product-team@yourcompany.com

# ─── WEBHOOK SECURITY ──────────────────────────────────────
# A random secret string shared between your webhook configs and this app.
# Generate one: openssl rand -hex 32
WEBHOOK_SECRET=generate_a_random_secret_here

# ─── VERCEL KV (for subscriptions persistence) ─────────────
# Auto-populated when you link a Vercel KV store via the dashboard.
# If not using Vercel KV, subscriptions fall back to in-memory (resets on deploy).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─── APP CONFIG ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=Product Request Tracker
