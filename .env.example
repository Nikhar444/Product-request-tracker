# ============================================================
# Product Request Tracker — Environment Variables
# ============================================================
# Copy to .env.local and fill in your values.
# ============================================================

# ─── FRESHSERVICE ───────────────────────────────────────────
# Your Freshservice domain (without https://)
FRESHSERVICE_DOMAIN=yourcompany.freshservice.com

# API key: Admin → Profile → API Key
FRESHSERVICE_API_KEY=your_freshservice_api_key_here

# The API name of the custom text field on Freshservice tickets
# that stores the linked Jira ticket key (e.g., "DPS-100999")
# Find it in Admin → Form Fields → Ticket Fields → your custom field
# The API name looks like: cf_jira_ticket or jira_id
FRESHSERVICE_JIRA_FIELD=jira_id

# ─── JIRA (Atlassian Cloud) ────────────────────────────────
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_EMAIL=service-account@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token

# Jira project key(s) to scope searches to (comma-separated)
# e.g., "DPS" or "DPS,PROD,ENG"
JIRA_PROJECT_KEYS=DPS

# Custom field ID that stores the requester's email address
# (so we know who to send notifications to)
# Create this in Jira: Settings → Issues → Custom Fields → Add "Requester Email"
# Format: customfield_XXXXX
JIRA_REQUESTER_EMAIL_FIELD=customfield_10060

# Custom field ID for requester's display name (optional)
JIRA_REQUESTER_NAME_FIELD=customfield_10061

# Custom field ID for the client/business unit (optional)
JIRA_CLIENT_FIELD=customfield_10062

# Custom field ID for the Product Owner (Product Manager)
# Find custom field IDs in: Jira Settings → Issues → Custom Fields → select the field
# Format: customfield_XXXXX
JIRA_PRODUCT_OWNER_FIELD=customfield_10063

# Custom field ID for the Solution Owner (Tech Lead)
JIRA_SOLUTION_OWNER_FIELD=customfield_10064

# ─── EMAIL (SMTP) ──────────────────────────────────────────
# M365:  smtp.office365.com / 587
# Gmail: smtp.gmail.com / 587 (use App Password)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply-product@yourcompany.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Product Request Updates

# ─── INTERNAL ──────────────────────────────────────────────
PRODUCT_TEAM_EMAIL=product-team@yourcompany.com

# ─── WEBHOOK SECURITY ──────────────────────────────────────
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=change_me

# ─── VERCEL KV (optional — for persistent subscriptions) ───
# Auto-set when you link a KV store in the Vercel dashboard
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─── APP ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=Product Request Tracker
